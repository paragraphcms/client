{
  "name": "@paragraphcms/client",
  "version": "3.0.6",
  "description": "Official TypeScript client for the Paragraph CMS API.",
  "license": "MIT",
  "author": "Paragraph CMS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run check && npm run build",
    "test": "npm run build && node --test test/client.unit.test.mjs test/client.integration.test.mjs",
    "test:unit": "npm run build && node --test test/client.unit.test.mjs",
    "test:integration": "npm run build && node --test test/client.integration.test.mjs"
  },
  "keywords": [
    "paragraphcms",
    "cms",
    "api",
    "sdk",
    "typescript"
  ],
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bottleneck": "^2.19.5",
    "ky": "^2.0.2"
  }
}
